# Python / tooling
.venv/
__pycache__/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Runtime state: contains run/launches/<account>/launch.json, which holds a live
# per-launch bearer token for the control relay.
run/
*.log

# Local config overrides
config.toml
config.local.toml

# ── Secrets: never commit these ────────────────────────────────────────────────
# Kaggle API credentials. The store this project actually uses lives outside the
# repo (~/.config/kaggle-rotate/), but guard against anyone dropping one in here.
kaggle.json
**/kaggle.json
access_token
**/access_token
credentials/
**/credentials/
launch.json
**/launch.json
*.pem
*.key
.env
.env.*
secrets.*
